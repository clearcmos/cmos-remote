root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,xml}]
indent_size = 2

# Kotlin and Gradle Kotlin DSL keep the ecosystem's 4-space default, which is
# what the existing sources use.
[*.{kt,kts}]
indent_size = 4

[*.md]
# Trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
